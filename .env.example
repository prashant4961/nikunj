# Copy to .env (or paste into Dokploy → Environment) before deploying.

# --- Database ---
POSTGRES_USER=nikunj
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=nikunj_creation

# --- Backend ---
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string
# Same-origin deploys (nginx proxies /api) can leave this as *
CORS_ORIGIN=*
ADMIN_EMAIL=admin@nikunjcreation.com
ADMIN_PASSWORD=change-this-admin-password
# Set to false once you manage the catalogue from the admin panel
SEED_ON_START=true

# --- Web ---
# Host port Dokploy/Traefik should route the storefront from
WEB_PORT=8080
